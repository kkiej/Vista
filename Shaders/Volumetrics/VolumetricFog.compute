// ============================================================================
//  近层体积雾（Step 3 档 A）
//
//  #19 交付「资源 + 分布 + 判据」，#20 交付逐 froxel 的光照注入，#21 交付深度积分，
//  #22a 交付抖动 + 时间重投影，#22b 交付蓝噪声源与横向形态的两档对照。
//  九个核：
//    FroxelPlaceholder   把切片几何写进注入表 —— 它**不是**雾，是一份能被读回来对账的
//                        已知内容。存在的理由是「RWTexture3D 绑定失败」这个坑：
//                        RTHandle 的 2D 便捷重载会静默建成 Tex2D，症状只有 Editor.log
//                        里一行 warning，画面上表现为整张表全零。让判据读到一个
//                        **非零且可预测**的内容，那条路径才算被覆盖过。
//    FroxelSliceVerify   把注入表当 SRV 读回来 + 做解析侧的恒等式，写进报告 buffer。
//    FroxelInjection     #20：逐 froxel 求 (σ_s·J, σ_t)，含级联阴影。
//    FroxelShadowProbe   #20/#21 的覆盖性判据：证明阴影查询与积分这两条路真的执行过。
//    FroxelIntegration   #21：一线程一柱，沿深度累积 (内散射, 1 − 透射率)。
//    FroxelSynthMedium   #21 判据的布景：把一个**均匀**的合成介质写满注入表。
//    FroxelIntegralVerify #21 判据的读回：把积分表 (0,0) 那一列 + 逐片的覆盖性扫描
//                        搬进报告 buffer。**核内不算任何误差**，参考解在 C# 侧。
//    FroxelReprojProbe   #22a 判据的探针：把重投影谓词的每一条拒绝分支的命中次数、
//                        静止恒等性的残差、以及抖动引起的相对亮度散布搬进探针 buffer。
//                        它调的是**线上那一份**共享函数（VistaFroxelReprojectUvw），
//                        靠调用点给 positionWS 减一个合成位移把拒绝分支驱进去。
//    FroxelJitterProbe   #22b 判据的探针：抖动源的直方图/矩/邻域相关，以及
//                        「逐列聚合偏移」在两个横向形态档下的对照。它**一张表都不读**，
//                        因为抖动偏移是下标的纯函数。
//
//  #22a 之后 VistaFogSettings.Mode 里**仍然没有** Froxel 档 ——
//  一个选了什么都不发生的枚举值等于把哑档位摆给美术，而把积分结果贴到画面上是 #25。
//  #20~#22 的这条链路因此挂在一个开发者开关上（默认关），画面上要看到它得开
//  Debug View；而那个开关关着的时候由 Window/Vista/Log Volumetric Fog State 点名。
// ============================================================================

#pragma kernel FroxelPlaceholder
#pragma kernel FroxelSliceVerify
#pragma kernel FroxelInjection
#pragma kernel FroxelShadowProbe
#pragma kernel FroxelIntegration
#pragma kernel FroxelSynthMedium
#pragma kernel FroxelIntegralVerify
#pragma kernel FroxelReprojProbe
#pragma kernel FroxelJitterProbe

// 与大气那批核同一条排除线：GLES 没有 RWTexture3D，编译只会产出一堆噪声。
#pragma only_renderers d3d11 vulkan metal playstation xboxone xboxseries switch

// ---------------------------------------------------------------- 阴影关键字
//  只声明级联这一个。
//
//  · **不**声明 _MAIN_LIGHT_SHADOWS_SCREEN：TransformWorldToShadowCoord
//    （URP Shadows.hlsl:356）对它是 #if defined，没声明就在**编译期**选中
//    级联矩阵那一支，于是这个核永远不会去读屏幕空间阴影图（compute 里根本没有
//    屏幕坐标）。声明了反而会让那条路悄悄生效，症状是光柱位置整体错开。
//  · **不**声明 _SHADOWS_SOFT*：SampleShadowmap 的软阴影阶梯是 4/9 tap 的 tent，
//    逐 froxel 付不起（默认档 240×135×64 = 207 万个 froxel）。而体积雾是低频的，
//    1 tap 的硬阴影在雾里看不出锯齿 —— HDRP 的 VBufferLighting 同样只取 1 tap。
//  · 漏设 _MAIN_LIGHT_SHADOWS_CASCADE 的降级是「所有点都按级联 0 查」，
//    也就是远处光柱错位 —— 一个**可归因**的症状。这比用 MainLightRealtimeShadow
//    好：那个函数在 MAIN_LIGHT_CALCULATE_SHADOWS 未定义时直接 return 1.0，
//    漏设的症状是「整个场景没有光柱、且不报错」。
//    这两条都由 FroxelShadowProbe 把编译期状态读回来点名。
#pragma multi_compile _ _MAIN_LIGHT_SHADOWS_CASCADE

// Shadows.hlsl 自己 include 了 Core.hlsl 与 core 的 Common.hlsl，所以放在最前面。
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"
#include "Packages/com.kkiej.vista/ShaderLibrary/AtmosphereDef.hlsl"
#include "Packages/com.kkiej.vista/ShaderLibrary/AtmosphereScattering.hlsl"
#include "Packages/com.kkiej.vista/ShaderLibrary/AerialPerspective.hlsl"
#include "Packages/com.kkiej.vista/ShaderLibrary/SphericalHarmonics.hlsl"
#include "Packages/com.kkiej.vista/ShaderLibrary/FroxelVolume.hlsl"

RW_TEXTURE3D(float4, _VistaFroxelInjectionRW);

// 同一张资源的 SRV view。绑定点必须与 UAV 分开：同一张纹理同时绑 UAV 与 SRV 是 UB，
// 这与反射那张中转表的教训是同一条（见 VistaLutSlot.SkyReflectionArray）。
TEXTURE3D(_VistaFroxelInjectionRead);

// ---------------------------------------------------------------- #22a 时间重投影
// 上一帧的注入表（**另一张**资源，不是上面那张的另一个 view）。双缓冲由
// VistaFroxelVolume 的写下标管，本核只读。
//
// 用 SAMPLE（三线性）而不是 LOAD：重投影出来的坐标一般不落在纹素中心上，
// 取最近邻的症状是相机匀速移动时雾在切片边界上「咯噔」一下 ——
// 一个看起来像「切片不够密」的失效。滤波模式由 RTHandle 分配时的 Bilinear 决定。
TEXTURE3D(_VistaFroxelInjectionHistory);

// 自检专用：喂给探针核的合成上一帧相机位移 (xyz, 角色标志)。
// 线上路径**一个字节都不下发** —— 零态 = 不位移。
//   w = 0: 无效（探针不该在这个状态下被派发，C# 侧的门挡着）
//   w = 1: 在线读数（xyz 必须为 0，量的是注入核实际吃进去的那份重投影）
//          外带一格「抖动自己制造的相对亮度散布」，用来给亮度死区的下端摆底。
//   w = 2: 静止恒等性（CPU 已把 prev 覆盖成 current，xyz 为 0）
//   w = 3: 失效覆盖之一 —— **位移**驱动的四条（NO_HISTORY / BEHIND / OFF_SCREEN /
//          OUT_OF_RANGE）。哪一条由 CPU 选的位移决定，shader 只按实际返回的掩码记。
//   w = 4: 失效覆盖之二 —— **合成 hist** 驱动的两条（NAN / LUMINANCE）。
//          没有任何相机位移能驱动它们，所以只能喂合成值；走的仍是线上那一份
//          VistaFroxelBlendHistory。
//
// 位移做在**调用点**（传 centreWS − probe.xyz）而不是给共享函数加一个形参：
// 加形参的话线上路径也得传一个 0，于是一个残留的脏全局能影响到线上；
// 做在调用点则它只能影响探针。代数上两者等价 —— 把上一帧相机平移 δ
// 等于在矩阵乘法与距离两处同时做 x → x − δ。
float4 _VistaFroxelReprojProbe;

// 每片两个 float4。布局见 VistaFroxelVolumeSelfTest 里的说明 ——
// 那边是唯一的消费者，把语义写在消费端而不是这里，是为了让「读错字段」
// 在判据的报表上直接显形。
RWStructuredBuffer<float4> _VistaFroxelSliceReportRW;

// #20 的覆盖性探针。定点编码 + 原子操作，槽位语义写在唯一的消费端
// （VistaVolumetricFogState）—— 与上面那个报告 buffer 同一条约定：
// 把语义写在消费端而不是这里，「读错字段」才会在判据的报表上直接显形。
RWStructuredBuffer<uint> _VistaFroxelShadowProbeRW;

// ---------------------------------------------------------------- #21 深度积分
RW_TEXTURE3D(float4, _VistaFroxelIntegralRW);

// #21 判据的报告 buffer。每片三个 float4，语义同样写在消费端
// （VistaFroxelIntegrationSelfTest）。
RWStructuredBuffer<float4> _VistaFroxelIntegrationReportRW;

// #21 判据的合成介质。x: σ_t (1/km)，y: 源项基准 S（预曝光后的量级）。
// 只有 FroxelSynthMedium 读它 —— 线上路径一个字节都不下发，
// 所以它的零态（σ_t = 0, S = 0）就是「没有布景」。
float4 _VistaFroxelSynthMedium;


// ----------------------------------------------------------------------------
//  占位：把切片几何写进注入表
//
//  四个通道故意各不相同且量级分明（segNear 到 segFar 之间差一个 ρ）——
//  若 XY 与 Z 轴被写反、或者索引差一片，读回来的比值就不是 ρ，判据能直接抓到。
//  写成 (1,1,1,1) 那种「能证明写过」的哨兵值就抓不到轴序错误。
// ----------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void FroxelPlaceholder(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_VistaFroxelSize.xyz))
        return;

    float slice = (float)id.z;
    _VistaFroxelInjectionRW[id] = float4(
        VistaFroxelStoredDistance(slice),
        VistaFroxelSampleDistance(slice),
        VistaFroxelSegmentNear(slice),
        VistaFroxelSegmentFar(slice));
}

// ----------------------------------------------------------------------------
//  判据核：一个线程一片
//
//  r0 走**纹理往返**（fp16），r1 走**解析**（fp32）。两者分开是必须的：
//  fp16 的相对 ulp 是 2^-11 ≈ 4.9e-4，把恒等式建立在读回来的 fp16 值上，
//  判据的地板就被抬到 1e-3 —— 那时「纹理坐标恒等式」（要求 1e-6）根本无法判定，
//  而它恰好是这套分布约定唯一的立足点。
// ----------------------------------------------------------------------------
[numthreads(64, 1, 1)]
void FroxelSliceVerify(uint3 id : SV_DispatchThreadID)
{
    uint slice = id.x;
    uint sliceCount = (uint)_VistaFroxelSize.z;
    if (slice >= sliceCount)
        return;

    // ---- r0：从注入表读回来（fp16）----
    // 固定取 (0,0) 那一列。XY 方向的映射（视锥四角插值）不在本判据的覆盖范围内 ——
    // 它由 AP 的 round-trip 判据覆盖，两者共用同一个 VistaApFroxelRayDirection。
    // 把它折进来会让一次失败无法归因到「距离映射」还是「方向映射」。
    float4 fromRt = LOAD_TEXTURE3D(_VistaFroxelInjectionRead, uint3(0, 0, slice));

    // ---- r1：解析侧的三条恒等式 ----
    float stored = VistaFroxelStoredDistance((float)slice);

    // ① 编解码 round-trip。相对误差。
    float roundTrip = VistaFroxelDecodeDistance(VistaFroxelEncodeDistance(stored))
                    * rcp(max(stored, 1e-9)) - 1.0;

    // ② 纹理坐标恒等式：存储距离编码回去必须**正好**落在纹素中心。
    //    这是「读端不需要半纹素偏移」的全部依据，所以要判绝对误差而不是相对。
    float texCenter = ((float)slice + 0.5) * VISTA_FROXEL_RCP_SLICES;
    float encodeErr = VistaFroxelEncodeDistance(stored) - texCenter;

    // ③ 求值点的位置。判「几何均值」这条恒等式的**乘法形式**：
    //      sample² == segNear · segFar
    //    而不是「求值点落在分段里的度量位置 frac」那条减法形式。
    //
    //    减法形式（frac = (sample − segNear)/(segFar − segNear)）第一版就是那么写的，
    //    实测在五个档上给出 0.95e-6 ~ 7.5e-6，全部越过 1e-6 的解析门；
    //    而读数严格按 1/(ρ−1) 排序（D 档 ρ−1 = 0.0366 最坏 7.5e-6，
    //    B 档 ρ−1 = 0.18 最好 0.95e-6），也就是**尺子自己的抵消误差**：
    //    三个量都 ≈ d，两两相减只剩 (ρ−1)·d，fp32 的 3e-7·d 绝对误差被放大成
    //    3e-7/(ρ−1) 的相对误差。那不是被测代码的缺陷，是判据的地板。
    //    「尺子的地板与被测量的期望值同量级时，尺子会自己伪造一个结论」——
    //    这里更糟：它伪造的是一个**失败**。
    //
    //    乘法形式没有相减，地板回到 3 次 exp 的 ~1e-6；而它要拒绝的最小错答案
    //    （把求值点写成度量中点）在五档里最小的 D 档是 3.3e-4，仍有 33 倍余量。
    //    片 0 走度量中点那一支（几何均值退化成 0），所以它判的是另一条恒等式
    //    sample == 0.5·segFar —— 同样是比值形式、同样没有相减。
    //    分支只在片 0，与被测函数里的分支位置**逐字对应**，一次失败仍然可归因。
    float segNear = VistaFroxelSegmentNear((float)slice);
    float segFar  = VistaFroxelSegmentFar((float)slice);
    float sample  = VistaFroxelSampleDistance((float)slice);
    float samplePos = slice >= 1
        ? sample * sample * rcp(max(segNear * segFar, 1e-12)) - 1.0
        : sample * rcp(max(0.5 * segFar, 1e-9)) - 1.0;

    // ④ 相邻切片比。这是「相对分辨率处处相同」的**定义**，
    //    判它比重算一遍闭式解更有力（后者只能抓打包错，抓不到公式错）。
    //    片 0 没有前一片，填 0 —— 判据侧按 slice >= 1 过滤，且要点名这一格是空的。
    float ratio = slice >= 1
        ? stored * rcp(max(VistaFroxelStoredDistance((float)slice - 1.0), 1e-9))
        : 0.0;

    _VistaFroxelSliceReportRW[slice * 2 + 0] = fromRt;
    _VistaFroxelSliceReportRW[slice * 2 + 1] = float4(roundTrip, encodeErr, samplePos, ratio);
}

// ============================================================================
//  #20 逐 froxel 光照注入
// ============================================================================

// ----------------------------------------------------------------------------
//  主光可见度：级联阴影，1 tap
//
//  ---- 为什么直接调 SampleShadowmap，而不是 MainLightRealtimeShadow ----
//  后者（Shadows.hlsl:385）在 MAIN_LIGHT_CALCULATE_SHADOWS 未定义时**直接 return 1.0**。
//  也就是关键字漏设的症状是「整个场景没有光柱、且不报错」——
//  正是项目里那条「一个默认关闭、又没有判据覆盖的开关，等于一段永远不会被发现写错的代码」。
//  直接调底层那三个函数，漏设关键字的后果退化成「全按级联 0 查」（远处光柱错位），
//  是个能被看见、能被归因的症状。三个函数都**没有**关键字门：
//    GetMainLightShadowSamplingData()  Shadows.hlsl:151
//    GetMainLightShadowParams()        Shadows.hlsl:186（已含 shadowStrength）
//    SampleShadowmap(...)              Shadows.hlsl:306（已含 BEYOND_SHADOW_FAR）
//
//  ---- isPerspectiveProjection 必须传 false ----
//  TransformWorldToShadowCoord 走 #else 那一支时返回的 w 恒为 0.0（Shadows.hlsl:361）。
//  传 true 会让 SampleShadowmap 做 xyz /= w，即除以 0 —— 症状是整张表 NaN，
//  而 NaN 会顺着三线性插值蔓延到全屏。
//
//  ---- 已知的隐藏依赖：GetMainLightShadowFade 读 URP 的 _WorldSpaceCameraPos ----
//  它（Shadows.hlsl:434）用 positionWS − _WorldSpaceCameraPos 求距离，而
//  _VistaFroxelCameraWS 存在的理由恰恰是不信任那个全局（Editor 立即模式下它由上一个
//  渲染过的相机留着）。这里仍然调它、不自己重写那一行 saturate ——
//  「同一个量的第二份实现连 8 行的辅助函数也算」，而淡出因子那一行同样算。
//  代价是这个核对 _WorldSpaceCameraPos 有依赖，所以 FroxelShadowProbe 把
//  |_WorldSpaceCameraPos − _VistaFroxelCameraWS.xyz| 读回来当判据的一项：
//  这条隐藏依赖于是变成一个能失败的打印数字，而不是一句注释里的担忧。
// ----------------------------------------------------------------------------
float VistaFroxelSunShadow(float3 positionWS)
{
    // 阴影贴图没绑（关阴影 / 反射探针 / 自检）时恒为全亮。
    // 不靠关键字判断而靠 CPU 下发的 uniform，理由见 VistaShaderIDs._VistaFroxelCameraWS。
    if (_VistaFroxelCameraWS.w < 0.5)
        return 1.0;

    float4 coord = TransformWorldToShadowCoord(positionWS);
    float  s = SampleShadowmap(
        TEXTURE2D_SHADOW_ARGS(_MainLightShadowmapTexture, sampler_LinearClampCompare),
        coord, GetMainLightShadowSamplingData(), GetMainLightShadowParams(),
        /*isPerspectiveProjection*/ false);

    // 1 = 完全淡出 ⇒ 淡出区恢复全亮，与不透明物体的阴影同一条渐变。
    return lerp(s, 1.0, GetMainLightShadowFade(positionWS));
}

// ----------------------------------------------------------------------------
//  像素中心 -> 屏幕 uv
//
//  提成函数是因为它有**三个**调用点（注入、阴影探针、重投影探针）。
//  max(·, 1.0) 是零态下的除零兜底；三处各写一份的话，那个兜底会各自漂移，
//  而漂移的症状是「某个探针在自检里读到 NaN，线上却正常」。
//
//  形参是 float2 而不是 uint2：横向抖动是连续量，加在这里。
// ----------------------------------------------------------------------------
float2 VistaFroxelPixelToUv(float2 pixelCenter)
{
    return pixelCenter * rcp(max(_VistaFroxelSize.xy, 1.0));
}

// ----------------------------------------------------------------------------
//  froxel 的格心世界位置（米）—— 重投影的**标称位置**
//
//  未抖动：xy 取像素中心，z 取 VistaFroxelReprojectDistance（e 上的片心，
//  不是 VistaFroxelSampleDistance —— 两者只有第 0 片差 0.144 m，理由见那两个函数的注释）。
//
//  为什么不让 VistaFroxelInject 顺带 out 一个 posWS 省掉这次重算：
//  它算出来的是**抖动后**的位置，拿去反查历史等于给历史加一个每帧变化的偏移，
//  症状是静止画面也在抖。重算的代价是一次 bilerp + 一次 normalize。
// ----------------------------------------------------------------------------
float3 VistaFroxelCentreWS(uint3 id)
{
    float3 rayDir = VistaApFroxelRayDirection(VistaFroxelPixelToUv((float2)id.xy + 0.5));
    return _VistaFroxelCameraWS.xyz + VistaFroxelReprojectDistance((float)id.z) * rayDir;
}

// ----------------------------------------------------------------------------
//  一个 froxel 的注入结果
//
//  提成函数是为了让注入核与探针核共用同一段能量计算。
//
//  ---- 抖动怎么进来（#22a）----
//  两个形参都是**连续量**：pixelCenter 是像素中心（横向抖动加在这里），
//  slice 是切片坐标（深度抖动加在这里）。调用方传
//  ((float2)id.xy + 0.5 + jitter.xy, (float)id.z + jitter.z)。
//
//  这里原先的注释写着「横向抖动由调用方把偏移加在 slice 上」，那是错的：
//  横向偏移改的是 VistaApFroxelRayDirection 的 uv，与距离无关，折不进 slice。
//  形参类型因此从 uint2 改成 float2。
//
//  深度抖动加在 slice（**指数坐标**）上而不是加在米上，有两条恒等式级别的收益：
//    ① 幅度 1 时抖动区间正好是这一段：slice ± 0.5 ⇒ decode((i∓0.5)/N)
//       = [VistaFroxelSegmentNear(i), VistaFroxelSegmentFar(i)]，逐位相同。
//       在米上抖就得自己挑区间，挑错的症状是相邻段的采样区间重叠或留缝。
//    ② 抖动的**期望**落在未抖动的求值点上（几何均值 = e 上的中点），
//       所以开抖动不会让雾整体变浓或变淡。在米上均匀抖的期望是**度量中点**，
//       比几何均值晚 0.0105 个分段（见 VistaFroxelSampleDistance 的头注），
//       症状是「打开抖动之后雾稍微浓了一点」—— 一个看起来像调好了的偏差。
//
//  已点名的代价：**第 0 片的深度抖动是惰性的**。slice = 0 + jitter.z ∈ [−0.5, 0.5)
//  全程走 VistaFroxelSampleDistance 的退化分支（slice < 0.5），恒返回 0.5·d_0。
//  它不是偏差 —— 0.5·d_0 正是该段 [0, d_0] 上均匀采样的期望；丢掉的只是那一片的
//  方差下降。该片长 0.31 m、位于 0.3 m 处，抖动本来要打散的阴影贴图阶梯
//  在那里是亚纹素的。横向抖动照常生效。
//
//  横向抖动**不夹紧**到 [0, size]：边缘 froxel 的采样点会落到视锥外半格，
//  而 VistaApFroxelRayDirection 在 uv 略微出界时是四角方向的线性外插，
//  给出一条视锥外半格的合法射线 —— 那正好是那个 froxel 真正覆盖的范围。
//  夹紧反而会把边缘那一列的期望往画面内侧拉，症状是画面四边一圈雾偏浓。
// ----------------------------------------------------------------------------
float4 VistaFroxelInject(float2 pixelCenter, float slice)
{
    float2 uv     = VistaFroxelPixelToUv(pixelCenter);
    float3 rayDir = VistaApFroxelRayDirection(uv);

    float dMeters = VistaFroxelSampleDistance(slice);
    float tKm     = dMeters * _VistaGround.w;   // 0.001，与 AP 同一个 CPU 下发的缩放

    // 大气空间的位置用 km（介质剖面按 r − bottomRadius 取），世界空间的位置用 m
    // （阴影矩阵是世界空间的）。两者不能互推：km 那一支在 6360 km 量级上 ulp 0.49 m，
    // 拿它反算世界位置会让阴影坐标按半米量化，症状是光柱边缘随相机移动跳格。
    float3 posKm = _VistaViewPosKm.xyz            + tKm     * rayDir;
    float3 posWS = _VistaFroxelCameraWS.xyz       + dMeters * rayDir;

    VistaRaymarchSettings s = VistaDefaultRaymarchSettings();
    s.applyPhase          = true;
    s.useMultiScattering  = true;
    // 与 AP 同理：远端的辐射由几何体提供，这里再加一次地面反弹就是重复计能量。
    s.includeGroundBounce = false;
    // 逐 froxel 只读 L_00 那一个系数（VistaSkyAmbientMean），不读满 9 个：
    // AP 那边把 9 次读提到切片循环外是因为它一柱一次，这里是逐 froxel，
    // 提不出去，所以要的就是只读一个系数的那个入口。
    s.fogAmbientRadiance  = VistaSkyAmbientMean();
    // includeFog 与本核无关：它只门住 VistaIntegrateScatteredLuminance 内部的取雾，
    // 而我们自己取雾、自己调逐点函数。留在默认 false 上，避免读者以为它有作用。

    VistaFogSample fog = VistaSampleFogAlongRay(tKm, rayDir.y);

    VistaScatterSample smp = VistaEvaluateScatterSample(
        posKm, rayDir, _VistaSunDirection.xyz, fog, s, VistaFroxelSunShadow(posWS));

    // ---- 存什么 ----
    //  rgb: 散射源项 σ_s·J，**预曝光**（× VISTA_EXPOSURE）。与 AP LUT 同一条约定，
    //       理由同样是 fp16 的 65504 天花板：浓雾对着低太阳时源项到 3.7e5 cd/m²。
    //  a:   灰度消光 σ_t (1/km)。
    //
    //  ---- 为什么消光存灰度而不是 RGB ----
    //  一个 float4 就够，而分通道要 RGBA16F × 2（注入 + 历史 + 积分三张表全部翻倍）。
    //  代价是彩色消光被平均掉，包络已经量过：
    //    · 默认档 D = 61.374 m：Rayleigh τ_blue = 2.0e-3 vs 灰度 1.07e-3
    //      ⇒ 透射率相差 0.096%，远在 1% 的 Weber 门之下；
    //    · clamp 到 shadow distance 的极端档 D = 500 m：τ_blue = 16.6e-3 vs 灰度 8.75e-3
    //      ⇒ 0.78%，仍在门内（这是「各通道对灰度均值」的差，不是蓝红之间的差 1.4%）；
    //    · 雾自己的 σ_t 由 densityTint 决定，中性色时**精确**为 0 误差。
    //  也就是说这个近似的失效点在 D 远大于 500 m 时，而 D 的上限本身被
    //  级联阴影距离压着（超出就没有光柱可注入了）。远处的彩色消光由 AP LUT 负责，
    //  它存的是分通道透射率。
    //
    //  注意：这里的 σ_t **含大气**（Rayleigh + Mie + 臭氧），不只有雾。
    //  D = 500 m 时蓝光的大气 τ 是 16.6e-3 = 1.66%，已经越过 1% 的门 ——
    //  近层体只算雾、把大气整段留给 AP 是不成立的。
    float greyExtinction = dot(smp.extinction, (1.0 / 3.0).xxx);
    return float4(smp.scattered * VISTA_EXPOSURE, greyExtinction);
}

// ----------------------------------------------------------------------------
//  取历史读数（#22a）
//
//  与 VistaFroxelBlendHistory 的分工：这里做**采样**（要纹理），那里做**混合**（纯函数）。
//  切在这条缝上，探针才能喂一个合成的 hist 去驱动 NaN 闸与亮度死区。
//
//  三线性（SAMPLE_LOD）而不是 LOAD：重投影出来的坐标一般不落在纹素中心上。
//  compute 里没有隐式导数，所以必须显式 LOD 0。
//
//  非 OK 时**跳过采样**。这不是为了省几个 froxel 的带宽，而是为了让失能态
//  （历史权重 0：首帧 / 换相机 / 档位 Off）整整 207 万个 froxel 一次 3D 纹理读都不发 ——
//  那个条件在整趟 dispatch 里是**统一**的（uniform），没有分支发散。
// ----------------------------------------------------------------------------
uint VistaFroxelFetchHistory(float3 centreWS, out float3 uvwPrev, out float4 hist)
{
    hist = (float4)0.0;

    uint mask = VistaFroxelReprojectUvw(centreWS, uvwPrev);
    if (mask == VISTA_REPROJ_OK)
        hist = SAMPLE_TEXTURE3D_LOD(_VistaFroxelInjectionHistory,
                                    sampler_LinearClamp, uvwPrev, 0.0);

    return mask;
}

// 注入表是逐 froxel 独立的（没有沿深度的累积），所以走满 3D 派发而不是
// 「一线程一柱、循环切片」。默认档 240×135×64 = 207 万个 froxel，
// 3D 派发给出 207 万个线程，而按柱只有 3.24 万个 —— 后者在 28 个 SM 上
// 隐藏不住 StructuredBuffer 与阴影贴图的访存延迟。
// #21 的积分是累积量，那个必须按柱，两者的派发形状本来就不同。
//
// ---- #22a：重投影就在这一趟里，不另开 pass ----
// 读历史（另一张资源的 SRV）+ 写本帧（UAV），同一趟 dispatch，
// 没有额外的表往返，也没有多一次 2M 个 froxel 的读写。HDRP 同样是这么做的。
// 顺序上的要求只有一条：历史那张表本帧还没被写过 —— 由 VistaFroxelVolume 的
// 双缓冲写下标保证（swap 在录制阶段做，一帧一次）。
[numthreads(8, 8, 1)]
void FroxelInjection(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_VistaFroxelSize.xyz))
        return;

    // 本帧的抖动样本。幅度为 0 时恒返回 0（失能态 = 零态），所以这里没有分支。
    float3 jitter  = VistaFroxelJitterOffset(id);
    float4 current = VistaFroxelInject((float2)id.xy + 0.5 + jitter.xy,
                                       (float)id.z + jitter.z);

    // 重投影用**格心**（未抖动），理由见 VistaFroxelReprojectUvw 与 VistaFroxelCentreWS。
    float3 uvwPrev;
    float4 hist;
    uint   mask = VistaFroxelFetchHistory(VistaFroxelCentreWS(id), uvwPrev, hist);

    // outMask / weight 在线上路径用不到（渲染只要返回值）；它们存在是为了让探针
    // 记读数时不必把权重再算一遍。
    uint  outMask;
    float weight;
    _VistaFroxelInjectionRW[id] = VistaFroxelBlendHistory(current, hist, mask, outMask, weight);
}

// ============================================================================
//  #21 深度积分
// ============================================================================

// ----------------------------------------------------------------------------
//  一线程一柱，沿深度做前缀积分
//
//  ---- 为什么必须按柱，而注入是满 3D ----
//  积分是**相机原点的累积量**：第 i 片的结果依赖前 i−1 片。按 froxel 派发就得
//  写成扫描（scan），而那要么跨线程组同步、要么把注入表读 N²/2 次。
//  按柱是 O(N) 且完全无同步。派发规模够不够：138×74 = 10212 柱 / 64 = 180 个组
//  ⇒ 28 个 SM 上 6.4 组/SM，比 #7 实测的 AP 派发地板（16 组 / 28 SM）高 11 倍，
//  所以这一趟**不在**那条 floor-bound 线上。
//
//  ---- 单段积分复用 VistaSegmentIntegral，不在这里另写 ----
//  ∫₀^dt S·e^{−σ·s} ds 已经有一份实现（AtmosphereScattering.hlsl:492），
//  它处理了两件这里同样会踩到的事：x ≤ 1e-4 时 (1 − e^{−x}) 的灾难性相消
//  （晴空最近那一段 x = 8.1e-6），以及 σ = 0 时的 NaN。
//  「同一个量的第二份实现连 8 行的辅助函数也算」。
//  代价是 σ_t 已经在注入时collapse成灰度，这里要广播成 float3 ⇒ 白做两次除法。
//  一柱 64 段、一万柱，换掉一份重复实现，值。
//
//  ---- 被**刻意放弃**的那个近似 ----
//  「中点矩形」写法（L += T_acc·e^{−x/2}·S·dt）省掉一次除法，相对偏差
//  x/(2·sinh(x/2)) − 1 = −x²/24 + O(x⁴)。实测包络 x ≤ 0.289 ⇒ −0.35%，
//  在 Weber 1% 之下 —— 也就是移动端档位可以直接切过去，这 0.35% 是**已经定过价**的。
//  主线保留解析式的理由不是这 0.35%，而是把 x² 阶的项从误差预算里移走，
//  好让「64 片够不够」只由插值误差回答（那条测量在 #27）。
//
//  ---- alpha 存 1 − T ----
//  见 FroxelVolume.hlsl 的头注：清空态（表从未被写）于是等于「透传」而不是「全黑」。
// ----------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void FroxelIntegration(uint3 id : SV_DispatchThreadID)
{
    uint3 size = (uint3)_VistaFroxelSize.xyz;
    if (any(id.xy >= size.xy))
        return;

    float3 lAcc = 0.0;
    float  tAcc = 1.0;

    for (uint slice = 0u; slice < size.z; ++slice)
    {
        // SRV 读。注入是上一趟 dispatch 写的，同一趟里读会拿到未定义值 ——
        // 派发的先后由 RenderGraph 的 UAV barrier 保证（见 VistaAtmospherePass）。
        float4 injected = LOAD_TEXTURE3D(_VistaFroxelInjectionRead, uint3(id.xy, slice));

        // 米 → km。缩放来自 CPU 下发的那一个，不写字面量（见 VistaFroxelSegmentLengthKm）。
        float dtKm = VistaFroxelSegmentLengthKm((float)slice, _VistaGround.w);

        lAcc += tAcc * VistaSegmentIntegral(injected.rgb, injected.aaa, dtKm);
        tAcc *= exp(-injected.a * dtKm);

        _VistaFroxelIntegralRW[uint3(id.xy, slice)] = float4(lAcc, 1.0 - tAcc);
    }
}

// ----------------------------------------------------------------------------
//  判据的布景：一个**均匀**的合成介质
//
//  为什么判据要自己造布景，而不是拿真实的雾去对：真实的 σ_t 沿视线随高度变，
//  闭式解就不存在了，那时「参考解」只能是另一个积分器 —— 也就是同一个量的第二份实现。
//  均匀介质下 L(d) = (S/σ_t)·(1 − e^{−σ_t·d}) 是**初等闭式解**，
//  判据的输入里因此一个被测对象的值都不含。
//
//  被测的积分核不分支于数据来源（它只读注入表），所以合成数据合法地覆盖它。
//
//  三个通道故意取 1 : 0.5 : 0.25。写成灰的话「rgb 被 swizzle」在报表上完全不可见，
//  而那是一个只改颜色、不改量级的错误 —— 最容易活到发布。
// ----------------------------------------------------------------------------
[numthreads(8, 8, 1)]
void FroxelSynthMedium(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_VistaFroxelSize.xyz))
        return;

    float s = _VistaFroxelSynthMedium.y;
    _VistaFroxelInjectionRW[id] = float4(s, s * 0.5, s * 0.25, _VistaFroxelSynthMedium.x);
}

// ----------------------------------------------------------------------------
//  判据的读回：把积分表搬进报告 buffer
//
//  **核内不算任何误差。** 参考解由 C# 侧用 double 算 —— 那边的
//  VistaFroxelVolumeDesc.StoredDistance 已经被 #19 的判据交叉验证过，
//  不是新的一份实现。这样判据的地板只剩 fp16 纹理往返的 4.88e-4，
//  而不会被核内 fp32 的抵消误差抬起来（那正是 #19 里减法形式的教训）。
//
//  r2 是**逐片的覆盖性扫描**：合成介质是均匀的 ⇒ 同一片里每一列的内容必须相同，
//  min 与 max 一旦分开就说明有一部分 froxel 没被写。只读 (0,0) 一列的话，
//  「XY 的 group 数少算一半」在报表上完全看不出来 —— 而那恰好是 #19 里
//  占位核铺满整个体积要防的同一个坑。
//
//  r3 是**归因行**，不是被判的量：把积分核实际用到的 dtKm 与它的来源
//  _VistaGround.w 原样搬出来。这两个数存在的理由是一个具体的隐藏依赖 ——
//  m→km 的缩放由 VistaAtmosphereParameters.Bind 上传，而它只在 PrepareLuts
//  里被调用。立即模式的自检要是忘了调 PrepareLuts，_VistaGround.w 就是 0
//  或者上一次渲染留下的脏值 ⇒ dtKm ≡ 0 ⇒ x ≡ 0 ⇒ 整张表全 0。
//  那时 r0/r2 会红，但红的成因有三个（派发没跑 / 布景没写 / 缩放是 0）无法区分。
//  把缩放印出来就只剩一个。
//
//  积分表走 UAV 读（不是 SRV）：与 #20 的探针同一条 —— 要看的就是 fp16 纹理里
//  实际存下来的量级，而且这样不必为它再开一个 SRV 绑定点。
// ----------------------------------------------------------------------------
#define VISTA_INTEGRAL_SWEEP_XY 16u

// 必须与 C# 侧的 VistaFroxelVolume.k_IntegrationReportFloat4PerSlice 一致。
// 不一致的症状：D3D11 上越界 UAV 写被**静默丢弃**，尾部若干片读回恒为初值，
// 报表上长得像「后半段没被积分」。
#define VISTA_INTEGRAL_REPORT_STRIDE 4u

[numthreads(64, 1, 1)]
void FroxelIntegralVerify(uint3 id : SV_DispatchThreadID)
{
    uint  slice = id.x;
    uint3 size  = (uint3)_VistaFroxelSize.xyz;
    if (slice >= size.z)
        return;

    float4 integral = _VistaFroxelIntegralRW[uint3(0, 0, slice)];
    float4 injected = LOAD_TEXTURE3D(_VistaFroxelInjectionRead, uint3(0, 0, slice));

    uint  nonFinite = 0u;
    // 哨兵取 ±1e30 而不是 0 / 1：0 是一个**合法**的 alpha（最近那一片几乎没积到雾），
    // 拿它当初值会让「一列都没扫到」与「雾很淡」在报表上长得一样。
    float aMin = 1e30, aMax = -1e30, lMax = -1e30;

    for (uint sy = 0u; sy < VISTA_INTEGRAL_SWEEP_XY; ++sy)
    {
        for (uint sx = 0u; sx < VISTA_INTEGRAL_SWEEP_XY; ++sx)
        {
            uint3 c = uint3(sx * size.x / VISTA_INTEGRAL_SWEEP_XY,
                            sy * size.y / VISTA_INTEGRAL_SWEEP_XY, slice);
            float4 v = _VistaFroxelIntegralRW[c];
            if (!all(isfinite(v)))
            {
                nonFinite += 1u;
                continue;
            }
            aMin = min(aMin, v.a);
            aMax = max(aMax, v.a);
            lMax = max(lMax, max(max(v.r, v.g), v.b));
        }
    }

    uint b = slice * VISTA_INTEGRAL_REPORT_STRIDE;
    _VistaFroxelIntegrationReportRW[b + 0u] = integral;
    _VistaFroxelIntegrationReportRW[b + 1u] = injected;
    _VistaFroxelIntegrationReportRW[b + 2u] = float4((float)nonFinite, aMin, aMax, lMax);
    // 与积分核**逐字同一个表达式**。写成 (segFar − segNear)·0.001 就成了第二份实现，
    // 而那份实现恰好绕开了这一格要归因的那个依赖。
    _VistaFroxelIntegrationReportRW[b + 3u] = float4(
        VistaFroxelSegmentLengthKm((float)slice, _VistaGround.w), _VistaGround.w, 0.0, 0.0);
}

// ----------------------------------------------------------------------------
//  覆盖性判据核
//
//  它要回答的不是「阴影值对不对」（那要一份第二实现），而是三个**执行性**问题：
//    ① 这条路径跑过吗                     —— 槽 RAN 位 + 探针计数
//    ② 编译期状态是我以为的那个吗         —— 关键字位（含两个必须为 0 的）
//    ③ 阴影查询真的读到东西了、且不是恒 1 —— min/max + 「有多少个点被遮」
//  ③ 依赖场景里近层体内确实有投影物，所以判据必须把「阴影图本身是不是空的」
//  分开读（槽 SHADOWMAP_MIN）：那是「阴影图没内容」与「阴影图有内容但我们查出来恒 1」
//  两种失败的唯一区分手段 —— 第一个可疑对象被修掉、读数却没变时，要能回头重新归因。
//
//  探针网格是固定的 32×32×16，不随体积分辨率变：判据的读数要能跨档位比较，
//  而跟着分辨率变的采样数会让「换档后 min 变了」分不清是阴影变了还是采样点变了。
// ----------------------------------------------------------------------------
#define VISTA_PROBE_DIM_XY 32
#define VISTA_PROBE_DIM_Z  16

#define VISTA_PROBE_SHADOW_MIN     0u
#define VISTA_PROBE_SHADOW_MAX     1u
#define VISTA_PROBE_FLAGS          2u
#define VISTA_PROBE_COUNT          3u
#define VISTA_PROBE_SHADOWED_COUNT 4u
#define VISTA_PROBE_CAM_DRIFT_MM   5u
#define VISTA_PROBE_NONFINITE      6u
#define VISTA_PROBE_INJECT_MAX     7u
#define VISTA_PROBE_SHADOWMAP_MIN  8u
#define VISTA_PROBE_SHADOWMAP_MAX  9u
#define VISTA_PROBE_SHADOW_STRENGTH 10u
#define VISTA_PROBE_SM_WIDTH       11u
#define VISTA_PROBE_SM_HEIGHT      12u
#define VISTA_PROBE_URP_SIZE_Z     13u

// ---- #21 追加：真实帧里的积分表读数 ----
// 立即模式的自检（VistaFroxelIntegrationSelfTest）用合成介质判数值正确性，
// 但它**不覆盖** RenderGraph 那条写入路径，也不覆盖真实雾的 x 包络。
// 这五个槽位是那两件事唯一的覆盖手段。
#define VISTA_PROBE_INTEGRAL_ALPHA_MAX 14u
#define VISTA_PROBE_INTEGRAL_LUM_MAX   15u
#define VISTA_PROBE_INTEGRAL_NONFINITE 16u
#define VISTA_PROBE_SEG_X_MIN          17u
#define VISTA_PROBE_SEG_X_MAX          18u

// ---- #22a 追加：重投影的覆盖性 ----
// 四个角色写进**互不重叠**的槽位区间（角色 1: 19~21 + 32 / 角色 2: 22~24 /
// 角色 3: 25~28 / 角色 4: 29~30；31 是角色 3+4 共用的线程计数），
// 于是「几种角色的读数被混在一起」在报表上不可能发生。
// 每个区间都带一个**线程计数** —— 「一个读数接近 0 的档位无法自证自己执行过」，
// 而这里 0 恰好是 STATIC_ERR 与 MASK_OR 的合法读数（完美 / 全 OK）。
#define VISTA_PROBE_REPROJ_ONLINE_COUNT   19u  // 角色 1：线程数
#define VISTA_PROBE_REPROJ_ONLINE_OK      20u  // 角色 1：mask == OK 的线程数
#define VISTA_PROBE_REPROJ_ONLINE_MASK_OR 21u  // 角色 1：所有掩码的 OR
#define VISTA_PROBE_REPROJ_STATIC_COUNT   22u  // 角色 2：线程数
#define VISTA_PROBE_REPROJ_STATIC_ERR     23u  // 角色 2：max|uvwPrev − VistaFroxelUvw|，×1e9
#define VISTA_PROBE_REPROJ_STATIC_MASK_OR 24u  // 角色 2：掩码 OR（必须恒为 0 = OK）
#define VISTA_PROBE_REPROJ_HIT_NOHIST     25u  // 角色 3
#define VISTA_PROBE_REPROJ_HIT_BEHIND     26u  // 角色 3
#define VISTA_PROBE_REPROJ_HIT_OFFSCR     27u  // 角色 3
#define VISTA_PROBE_REPROJ_HIT_RANGE      28u  // 角色 3
#define VISTA_PROBE_REPROJ_HIT_LUM        29u  // 角色 4
#define VISTA_PROBE_REPROJ_HIT_NAN        30u  // 角色 4
#define VISTA_PROBE_REPROJ_COVER_COUNT    31u  // 角色 3 + 4：线程数
#define VISTA_PROBE_REPROJ_JITTER_SPREAD  32u  // 角色 1：抖动引起的相对亮度散布 max，×1e6

// ---- #22b 追加：抖动源本身的统计（判据⑰⑱⑲⑳ + 档位接线）----
//  由**另一个核**（FroxelJitterProbe）写，槽位区间与上面完全不重叠。
//  那个核一张表都不读 —— 抖动偏移是下标的纯函数 —— 所以它**不依赖体积的 xy 尺寸**，
//  唯一的体积依赖是⑳要用的片数（见 VISTA_JITTER_AGG_SLICES）。
//
//  ⑰ 源图的直方图与矩：8 个桶 + Σv + Σv²。窗口固定 64×64 = 4096 个样本，
//    正好是瓦片的一个整周期，所以「秩均匀 ⇒ 每桶正好 512」是一条**精确**的期望，
//    不是统计近似。它要挡的是一次 sRGB 重导入（直方图不再均匀 ⇒ 均值 ≠ 0.5
//    ⇒ 抖动偏移的期望 ≠ 0 ⇒ 开抖动之后雾整体偏浓或偏淡）。
//  ⑱ 动画后那一片的一阶邻域相关（lag (1,0) 与 (0,1)）—— 蓝噪声必须显著为负、
//    程序化必须 ≈ 0。量的是 frac(v + φ)，不是源图（那条「加相位是平移」的论证已被否证）。
//  ⑲ 三路抽头之间的相关 —— 抽头偏移选重了（或写成同一个）时这一格红。
//  ⑳ 逐列聚合偏移 Ā 的两档对照，见 FroxelJitterProbe 头部。
//
//  两组（程序化 / 蓝噪声）各 11 个槽位，顺序必须一致（SUM.xyz, SQ.xyz, NB_X, NB_Y,
//  XY, XZ, YZ）—— 顺序写错的症状不会静默：相关性读数被记进方差槽时 Var 会跑到
//  0.25 量级（一个 |n'| 的一阶量），离解析值 0.0839869 差 3 倍。
#define VISTA_PROBE_BN_HIST0        33u  // 33..40：源图 8 桶直方图，每桶期望 512
#define VISTA_PROBE_BN_SUM          41u  // Σv，×1e5（期望 2048 ⇒ 2.048e8）
#define VISTA_PROBE_BN_SQ           42u  // Σv²，×1e5（期望 1368.0105）
#define VISTA_PROBE_BN_COUNT        43u  // 线程数（期望 4096）

#define VISTA_PROBE_JIT_PROC_BASE   44u  // 44..54：程序化档的 11 个矩槽
#define VISTA_PROBE_JIT_BLUE_BASE   55u  // 55..65：蓝噪声档的 11 个矩槽
#define VISTA_PROBE_JIT_STRIDE      11u

// 组内偏移。C# 侧按 BASE + 这几个常量镜像，两边任何一处错位都会让⑰的
// 「Var 落在 0.084 附近」这一格先红。
#define VISTA_PROBE_JIT_OFS_SUM     0u   // +0/+1/+2 = Σn'.x / Σn'.y / Σn'.z
#define VISTA_PROBE_JIT_OFS_SQ      3u   // +3/+4/+5 = Σn'.x² / …
#define VISTA_PROBE_JIT_OFS_NB_X    6u   // Σ n'.x(p)·n'.x(p + (1,0))
#define VISTA_PROBE_JIT_OFS_NB_Y    7u   // Σ n'.x(p)·n'.x(p + (0,1))
#define VISTA_PROBE_JIT_OFS_XY      8u   // Σ n'.x·n'.y
#define VISTA_PROBE_JIT_OFS_XZ      9u
#define VISTA_PROBE_JIT_OFS_YZ     10u

#define VISTA_PROBE_JIT_COUNT      66u   // ⑰⑱⑲ + 档位接线的线程数（期望 4096）

// ⑳：逐列聚合偏移 Ā 的两档读数。DAXIS/DDIAG 是**逐点差的 max**，不是相关系数 ——
// 相关系数量不出这件事（N 个场平均之后分子分母同比缩小，ρ₁ 不变），
// 而条纹的预言是一条**逐点恒等式** Ā(x+1,y+1) = Ā(x,y)，它的地板只有 fp32 求和序误差。
// DAXIS 是必需的对照：少了它，一个「Ā 恒为常数」的 bug 会把 DDIAG 那条恒等式假通过。
#define VISTA_PROBE_AGG_COL_SUM    67u   // ×1e5，Ā + 0.5
#define VISTA_PROBE_AGG_COL_SQ     68u   // ×1e5
#define VISTA_PROBE_AGG_COL_DAXIS  69u   // max|Ā(p+(1,0)) − Ā(p)|，×1e9
#define VISTA_PROBE_AGG_COL_DDIAG  70u   // max|Ā(p+(1,1)) − Ā(p)|，×1e9
#define VISTA_PROBE_AGG_SLC_SUM    71u
#define VISTA_PROBE_AGG_SLC_SQ     72u
#define VISTA_PROBE_AGG_SLC_DAXIS  73u   // 必须 O(1e-2)：否则 DDIAG 是被常数场假通过的
#define VISTA_PROBE_AGG_SLC_DDIAG  74u   // 必须 ≈ 0：这就是对角条纹那条恒等式
#define VISTA_PROBE_AGG_COUNT      75u   // ⑳的线程数（期望 4096；片数 ≠ 64 时为 0）

// 档位接线的**双向**判据：四个 max|online − 某一档|。
// CPU 按 settings 断言「{COL, SLC} 恰好有一个为 0 且是它选的那一个」，
// 以及「{PROC, BLUE} 恰好有一个为 0 且是它选的那一个」。
// 期望来自 settings 对象、读数来自 uniform ⇒ 不是自证。
#define VISTA_PROBE_JIT_D_COL      76u   // ×1e9
#define VISTA_PROBE_JIT_D_SLC      77u
#define VISTA_PROBE_JIT_D_PROC     78u
#define VISTA_PROBE_JIT_D_BLUE     79u

// 判据⑰d：**向被测资源自己问尺寸**，而不是相信 CPU 侧那句
// 「VistaBlueNoise.available = True」。走 InterlockedMax，初值 0 ⇒
// 「没绑上」与「核压根没跑」都读 0 —— 这两者由 VISTA_PROBE_BN_COUNT
// （期望 4096）分开，报表必须点名这条依赖。
//
// 存在的理由（与判据⑥a 完全同一条）：#22b 第一次修好之后，⑰b 的直方图
// 仍然是 [4096,0,…]、⑰c 的均值仍然精确为 0，而 CPU 侧一切表面证据都显示
// 接上了（资产 available、import 过、UseTexture 过、逐核 SetComputeTextureParam
// 过）。此时「未绑定 SRV 在 D3D11 上读到全 0」与「绑上了但这张资产的
// GPU 内容是 0」在报表上**长得一模一样** —— 而这一格把两者分开：
// 0×0 ⇒ 绑定没到达核；64×64 ⇒ 绑定到了，问题在资产内容。
#define VISTA_PROBE_BN_WIDTH       80u
#define VISTA_PROBE_BN_HEIGHT      81u

// 位 4「跑过」是必需的：只靠位 0~3 的话，一个从未派发的核留下的全零
// 与「级联关 + 阴影图未绑 + 屏幕空间关 + 软阴影关」这个**完全合法**的组合
// 在报表上长得一模一样。
#define VISTA_PROBE_FLAG_CASCADE     1u
#define VISTA_PROBE_FLAG_SHADOWMAP   2u
#define VISTA_PROBE_FLAG_SCREEN      4u
#define VISTA_PROBE_FLAG_SOFT        8u
#define VISTA_PROBE_FLAG_RAN         16u

// 定点编码的公共上限。uint 到 4.29e9，留一位数的余量防溢出回绕 ——
// 回绕的症状是「最大值变成一个很小的数」，那会把一次失败伪装成通过。
#define VISTA_PROBE_FIXED_MAX 4.0e9

uint VistaProbeFixed(float v, float scale)
{
    return (uint)clamp(v * scale, 0.0, VISTA_PROBE_FIXED_MAX);
}

// 探针网格 -> froxel 索引。取每格中心，避免只采到边界那一列。
// 两个探针核共用这一份：网格映射写两遍的话，「换档后读数变了」会分不清是
// 被测量变了还是两个核采到了不同的 froxel。
uint3 VistaProbeFroxelIndex(uint3 id, uint3 size)
{
    uint3 fid = uint3(
        (uint)((id.x + 0.5) * size.x / VISTA_PROBE_DIM_XY),
        (uint)((id.y + 0.5) * size.y / VISTA_PROBE_DIM_XY),
        (uint)((id.z + 0.5) * size.z / VISTA_PROBE_DIM_Z));
    return min(fid, size - 1u);
}

[numthreads(8, 8, 1)]
void FroxelShadowProbe(uint3 id : SV_DispatchThreadID)
{
    // 关键字与「跑过」标记：放在任何 return 之前。
    if (all(id == 0u))
    {
        uint flags = VISTA_PROBE_FLAG_RAN;
        #ifdef _MAIN_LIGHT_SHADOWS_CASCADE
            flags |= VISTA_PROBE_FLAG_CASCADE;
        #endif
        #ifdef _MAIN_LIGHT_SHADOWS_SCREEN
            flags |= VISTA_PROBE_FLAG_SCREEN;      // 必须为 0，见头部的 pragma 说明
        #endif
        #if defined(_SHADOWS_SOFT) || defined(_SHADOWS_SOFT_LOW) || defined(_SHADOWS_SOFT_MEDIUM) || defined(_SHADOWS_SOFT_HIGH)
            flags |= VISTA_PROBE_FLAG_SOFT;        // 必须为 0
        #endif
        if (_VistaFroxelCameraWS.w >= 0.5)
            flags |= VISTA_PROBE_FLAG_SHADOWMAP;

        InterlockedOr(_VistaFroxelShadowProbeRW[VISTA_PROBE_FLAGS], flags);

        // 相机位置漂移：这个核对 URP 的 _WorldSpaceCameraPos 的隐藏依赖，
        // 见 VistaFroxelSunShadow 的注释。读数不为 0 就说明淡出因子算错了。
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_CAM_DRIFT_MM],
            VistaProbeFixed(length(_WorldSpaceCameraPos - _VistaFroxelCameraWS.xyz), 1000.0));

        // 主光的阴影强度。SampleShadowmap 的返回是 lerp(1, s, strength)，
        // 所以「全被遮」的地板是 1 − strength，不是 0 —— 不记它的话，
        // 判据里那个 min 读数是个无法归因的数（本项目实测 0.2 ⇒ strength 0.8）。
        //
        // 它同时补上了「一个点都没被遮」的第三种成因：strength == 0 时
        // SampleShadowmap 恒返回 1，而那与「矩阵错了」在报表上长得一样。
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_SHADOW_STRENGTH],
            VistaProbeFixed(GetMainLightShadowParams().x, 1.0e6));

        // URP 那个 _MainLightShadowmapSize.z（atlas 宽）的归因读数。
        // 它**不是**一个可靠的全局：MainLightShadowCasterPass.cs:334 把整段
        // SetGlobalVector 包在 if (shadowData.supportsSoftShadows) 里，
        // 硬阴影档下这一帧根本不下发，读到的是**别人留下的脏值** ——
        // 本项目实测 1，来自同文件 :34 的 s_EmptyShadowmapSize = (1,1,1,1)
        //（某个走过 empty-shadowmap 路径的相机设的）。1×1 是一个看起来完全合法的
        // 尺寸，拿它算坐标全塌到 (0,0) 且不报错，所以要把这个读数印出来。
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_URP_SIZE_Z],
            VistaProbeFixed(_MainLightShadowmapSize.z, 1.0));

    }

    if (id.x >= VISTA_PROBE_DIM_XY || id.y >= VISTA_PROBE_DIM_XY || id.z >= VISTA_PROBE_DIM_Z)
        return;

    uint3 size = (uint3)_VistaFroxelSize.xyz;
    if (any(size == 0u))
        return;

    // 阴影图自己有没有内容：与体积无关的一路读数，用于把
    //「阴影图是空的」与「阴影图有内容但查出来恒 1」分开归因。
    // 32×32 个 texel，整个 atlas（含全部级联）都被这个网格覆盖到。
    // 只让 id.z == 0 那一层做，否则同样 1024 个 texel 会被读 16 遍。
    //
    // ---- 尺寸自己问纹理要，**不读 _MainLightShadowmapSize** ----
    // 那个全局在 URP 里只在软阴影档下发：MainLightShadowCasterPass.cs:334
    // 把 _ShadowOffset0/1 与 _ShadowmapSize 三行一起包在
    // if (shadowData.supportsSoftShadows) 里。硬阴影档下这一帧根本不下发，
    // 读到的是别人留下的脏值 —— 实测 1（s_EmptyShadowmapSize = (1,1,1,1)，同文件 :34）
    // ⇒ smCoord 恒为 (0,0) ⇒ atlas 读回来是一个常数。
    // 第一版就是那么写的，本判据因此红了一次，而红的理由不是场景没有投影物
    //（同一趟里 1034 个点被遮）。URP 自己不受影响：那个尺寸只被 tent 软阴影的
    // offset 用到，1 tap 的硬阴影路径根本不读它。
    //
    // ---- 判的是「atlas 是不是一个常数」，不是「min 等于某个清空值」 ----
    // 清空值取决于 UNITY_REVERSED_Z：D3D11/Vulkan/Metal 上 URP 的阴影矩阵带
    // reversed-Z 翻转，清空态是 **0.0** 而不是 1.0。按「清空态是 1.0」写出来的门
    // 会在 atlas 全空时读到 min = 0 并宣布「有内容」—— 一个**假通过**，
    // 而且它坏在本判据唯一的职责上。「空 atlas 是一个常数」不依赖任何约定。
    if (_VistaFroxelCameraWS.w >= 0.5 && id.z == 0u)
    {
        uint smW, smH;
        _MainLightShadowmapTexture.GetDimensions(smW, smH);

        // 尺寸也记进探针：GetDimensions 万一返回 0，症状仍然是「atlas 是常数」，
        // 与「场景里没投影物」撞车。把它变成一个能失败的打印数字。
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_SM_WIDTH],  smW);
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_SM_HEIGHT], smH);

        if (smW > 0u && smH > 0u)
        {
            // 整数算格心（(2i+1)/(2N)），避免 float 舍入把两个相邻探针撞到同一个 texel。
            int2 smCoord = int2(
                (int)((id.x * 2u + 1u) * smW / (2u * VISTA_PROBE_DIM_XY)),
                (int)((id.y * 2u + 1u) * smH / (2u * VISTA_PROBE_DIM_XY)));
            float smDepth = LOAD_TEXTURE2D(_MainLightShadowmapTexture, smCoord).r;
            InterlockedMin(_VistaFroxelShadowProbeRW[VISTA_PROBE_SHADOWMAP_MIN],
                VistaProbeFixed(smDepth, 1.0e6));
            InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_SHADOWMAP_MAX],
                VistaProbeFixed(smDepth, 1.0e6));
        }
    }

    // 探针网格 -> froxel 索引。与重投影探针共用同一份映射。
    uint3 fid = VistaProbeFroxelIndex(id, size);

    // 阴影走**被测函数自己**这一份实现，不重写。
    float2 uv      = VistaFroxelPixelToUv((float2)fid.xy + 0.5);
    float3 rayDir  = VistaApFroxelRayDirection(uv);
    float  dMeters = VistaFroxelSampleDistance((float)fid.z);
    float  shadow  = VistaFroxelSunShadow(_VistaFroxelCameraWS.xyz + dMeters * rayDir);

    InterlockedMin(_VistaFroxelShadowProbeRW[VISTA_PROBE_SHADOW_MIN],
        VistaProbeFixed(shadow, 1.0e6));
    InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_SHADOW_MAX],
        VistaProbeFixed(shadow, 1.0e6));
    InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_COUNT], 1u);
    if (shadow < 0.999)
        InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_SHADOWED_COUNT], 1u);

    // 注入表的内容体检。读 UAV 而不是 SRV：要看的就是**实际写进去的东西**，
    // 而且 fp16 的量级余量（65504 天花板）只有从纹理里读回来才算量过。
    float4 injected = _VistaFroxelInjectionRW[fid];
    if (!all(isfinite(injected)))
        InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_NONFINITE], 1u);
    else
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_INJECT_MAX],
            VistaProbeFixed(max(max(injected.r, injected.g), injected.b), 1.0e3));

    // ---- #21：积分表的内容体检 + 真实雾的 x 包络 ----
    // 这一段是「RenderGraph 那条积分写入路径真的执行过」的唯一证据 ——
    // 立即模式自检用的是自己造的合成介质，它跑不到这条路上。
    //
    // alpha 的 max 而不是 min：这张表存 1 − T，清空态是 0，也就是
    // **max == 0 才是「没被写」**。存 T 的话清空态与「无雾」同为 0，
    // 这个格子就变成空判据了 —— 这是选 1 − T 顺带买到的一条可判性。
    float4 integral = _VistaFroxelIntegralRW[fid];
    if (!all(isfinite(integral)))
        InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_INTEGRAL_NONFINITE], 1u);
    else
    {
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_INTEGRAL_ALPHA_MAX],
            VistaProbeFixed(integral.a, 1.0e6));
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_INTEGRAL_LUM_MAX],
            VistaProbeFixed(max(max(integral.r, integral.g), integral.b), 1.0e3));
    }

    // x = σ_t·Δ 是 VistaSegmentIntegral 选分支的那个量，也是「中点矩形」近似
    // 误差 x²/24 的自变量。推导出来的包络是 [8.1e-6, 0.289]（晴空最近一段 ~
    // 能见度 50 m 的雾最远一段），但那是**算**出来的，不是量出来的。
    // 定点缩放取 1e9：下端 8.1e-6 还剩 8100 个刻度，上端 0.289 也远在
    // VISTA_PROBE_FIXED_MAX 之内 —— 一个 1e6 的缩放会把下端压到 8 个刻度上，
    // 那时「包络下端」这个读数就落进自己尺子的地板里了。
    float segX = injected.a * VistaFroxelSegmentLengthKm((float)fid.z, _VistaGround.w);
    InterlockedMin(_VistaFroxelShadowProbeRW[VISTA_PROBE_SEG_X_MIN],
        VistaProbeFixed(segX, 1.0e9));
    InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_SEG_X_MAX],
        VistaProbeFixed(segX, 1.0e9));
}

// ============================================================================
//  #22a 重投影的覆盖性探针
//
//  它要回答四个问题，四个角色各答一个（角色由 _VistaFroxelReprojProbe.w 选，
//  写进互不重叠的槽位区间）：
//    ① 线上这一帧的重投影，实际命中了哪些分支、有多少格用上了历史（角色 1）
//    ② 相机静止时，格心投回去是否**正好**落在自己那一格的纹素中心（角色 2）
//    ③ 每一条拒绝分支真的能被驱进去吗（角色 3：位移驱动；角色 4：合成 hist）
//    ④ 抖动自己制造了多大的逐帧亮度变化（角色 1 的额外一格）
//
//  ---- 派发顺序有一条硬要求 ----
//  角色 1 必须**第一个**派发。角色 2~4 会覆盖 VistaFroxelReprojCB 里的上一帧矩阵/
//  范围/相机位置，而角色 1 要量的正是注入核这一帧实际吃进去的那一份 ——
//  「参考解要用被测核实际吃进去的那份输入」。顺序由 C# 侧保证并在报表上点名。
//
//  ---- 为什么角色 2 存在 ----
//  静止恒等性本来可以「等相机不动的那一帧顺手量一下」，但那样一来相机一动
//  这一格就是空判据。角色 2 让 CPU 把上一帧那套参数**覆盖成本帧的**，
//  于是这条恒等式无条件成立、无条件可判。
//
//  它是**必要不充分**的：prev = current 时恒等成立，并不证明 prev ≠ current 时
//  矩阵是上一帧那个。补上另一半的是判据⑭（CPU 侧的整数：矩阵是第 frameIndex−1 帧抓的）。
// ============================================================================
[numthreads(8, 8, 1)]
void FroxelReprojProbe(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= VISTA_PROBE_DIM_XY || id.y >= VISTA_PROBE_DIM_XY || id.z >= VISTA_PROBE_DIM_Z)
        return;

    uint3 size = (uint3)_VistaFroxelSize.xyz;
    if (any(size == 0u))
        return;

    // 角色 0 = 无效。C# 侧的门本来就不该派发它，这里再挡一次是为了让
    // 「忘了下发 _VistaFroxelReprojProbe」的症状是**所有计数为 0**（判据直接红），
    // 而不是所有读数都被记到角色 1 的槽位上（一次假通过）。
    uint role = (uint)(_VistaFroxelReprojProbe.w + 0.5);
    if (role == 0u)
        return;

    uint3 fid = VistaProbeFroxelIndex(id, size);

    // 合成位移做在**调用点**（而不是给共享函数加一个形参），见资源声明处的说明：
    // 这样一个残留的脏全局只能影响探针，影响不到线上路径。
    float3 centreWS = VistaFroxelCentreWS(fid) - _VistaFroxelReprojProbe.xyz;

    float3 uvwPrev;
    float4 hist;
    uint   mask = VistaFroxelFetchHistory(centreWS, uvwPrev, hist);

    // ------------------------------------------------------------------ 角色 1
    if (role == 1u)
    {
        InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_ONLINE_COUNT], 1u);
        InterlockedOr (_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_ONLINE_MASK_OR], mask);
        if (mask == VISTA_REPROJ_OK)
            InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_ONLINE_OK], 1u);

        // ---- 抖动引起的相对亮度散布 ----
        //  这一格量的是「抖动自己制造了多大的逐帧亮度变化」，它是
        //  luminanceRejectStart（死区下端）的**下界**：死区摆在它之下的话，
        //  这条失效规则会把自己的抖动噪声当成「场景变了」而降权，
        //  亲手毁掉它本该保护的累积。
        //
        //  **不**拿 hist 与 current 去比 —— 那个差里混着相机运动与场景变化，
        //  量出来的是一个被污染的上界。这里改成两次**独立抖动抽样**的相对差：
        //  逐帧的相位平移本来也是独立抽样，所以两者同分布。
        //
        //  第二次抽样靠**挪相位**（VistaFroxelJitterOffsetAltPhase），不是挪下标。
        //  #22a 原来写的是「把 hash 的 z 输入挪 977 片」，#22b 把它换掉了：
        //  逐列一致档（默认档）下横向抖动看到的 z 恒为 0，于是挪 z 对横向偏移
        //  **一个 bit 都不改** ⇒ jA.xy ≡ jB.xy ⇒ 读数里只剩深度那一项。
        //  那是一个**偏低**的下界，而偏低的下界会让死区看起来有裕度 ——
        //  「一个偏低的成本代理会让门看起来有裕度」。
        //
        //  读数是 16384 个 froxel 上的 **max**，不是均值 —— 死区要挡的是尾部。
        float3 jA = VistaFroxelJitterOffset(fid);
        float3 jB = VistaFroxelJitterOffsetAltPhase(fid);
        float  lA = VistaFroxelLuminance(
            VistaFroxelInject((float2)fid.xy + 0.5 + jA.xy, (float)fid.z + jA.z).rgb);
        float  lB = VistaFroxelLuminance(
            VistaFroxelInject((float2)fid.xy + 0.5 + jB.xy, (float)fid.z + jB.z).rgb);

        // 分母与 VistaFroxelLuminanceWeight 里那一份逐字相同（max 两者 + 1e-6 兜底）——
        // 这一格的读数要能直接与死区下端比大小，两处用不同的归一化就没法比。
        float rel = saturate(abs(lA - lB) / max(max(lA, lB), 1e-6));
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_JITTER_SPREAD],
            VistaProbeFixed(rel, 1.0e6));
        return;
    }

    // ------------------------------------------------------------------ 角色 2
    if (role == 2u)
    {
        // CPU 已把上一帧那套矩阵/范围/相机位置覆盖成本帧的，于是格心投回去
        // 必须**正好**落在自己那一格的纹素中心上。
        //
        // xy 这条为什么是精确的（而不是「近似」）：视锥四角是 z = 1 平面上的
        // **未归一化**角点（VistaAtmosphereViewData.SetFrustumRays 用
        // CalculateFrustumCorners(rect, 1f, ...)），所以四角的双线性插值给出的是
        // 该平面上的精确点，其投影回来正好是 uv；normalize 只改长度不改方向，
        // cam + t·dir 仍在同一条射线上。它依赖 _VistaFroxelPrevViewProj 由
        // camera.projectionMatrix 构造（与 CalculateFrustumCorners 同源）——
        // 换成手工覆盖的投影矩阵这一格会红，而那正是想要的红。
        //
        // z 这条：dPrev = ReprojectDistance(i) = decode(i/N)，encode 回去 = i/N，
        // 加上那半个纹素 = (i+0.5)/N = VistaFroxelUvw(fid).z。残差只有
        // log/exp 的 fp32 往返误差（与判据①同一个量级，~1e-7）。
        float3 uvwNow = VistaFroxelUvw(fid);
        float3 d      = abs(uvwPrev - uvwNow);
        float  err    = max(max(d.x, d.y), d.z);

        InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_STATIC_COUNT], 1u);
        InterlockedOr (_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_STATIC_MASK_OR], mask);
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_STATIC_ERR],
            VistaProbeFixed(err, 1.0e9));
        return;
    }

    InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_COVER_COUNT], 1u);

    // ------------------------------------------------------------------ 角色 3
    if (role == 3u)
    {
        // 位移驱动的四条拒绝分支。哪一条被驱进去由 CPU 选的位移决定，
        // 这里只按**实际返回的**掩码计数 —— 反过来（CPU 说该命中哪一条、
        // shader 照着记）就成了一个无法失败的判据。
        //
        // 用 else-if 链而不是逐位 &：掩码是**互斥**的（谓词第一条命中就 return），
        // 而 & 会让「掩码里意外出现两位」这件事在报表上被静默吃掉。
        if (mask == VISTA_REPROJ_NO_HISTORY)
            InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_HIT_NOHIST], 1u);
        else if (mask == VISTA_REPROJ_BEHIND)
            InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_HIT_BEHIND], 1u);
        else if (mask == VISTA_REPROJ_OFF_SCREEN)
            InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_HIT_OFFSCR], 1u);
        else if (mask == VISTA_REPROJ_OUT_OF_RANGE)
            InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_HIT_RANGE], 1u);
        return;
    }

    // ------------------------------------------------------------------ 角色 4
    //  混合那两条守卫。没有任何相机位移能驱动它们（NaN 进不了线上的表，
    //  亮度差取决于场景），所以这里喂**合成的 hist**，走的仍然是线上那一份
    //  VistaFroxelBlendHistory。
    //
    //  这一格证明的是「闸接对了」（谓词命中 ⇒ 掩码被置上 ⇒ 早退），
    //  **不是**「AnyIsNaN 在这台硬件上判得对」—— 后者是 URP 的位模式比较，
    //  不是本项目的量。线上那条路径会不会真的读到 NaN 是另一格（角色 1 的掩码 OR），
    //  而它由构造保证读不到（CPU 侧的 historyContentValid 挡着未写过的表）。
    {
        uint  m;
        float w;

        // NaN 从**uniform** 里构造，而不是写 asfloat(0x7FC00000u) 那种编译期常量：
        // 常量会被折叠，于是这条闸在编译期就被判定完了，运行时一条指令都不执行。
        // probe.xyz 在角色 4 下是 0，OR 上 0x7FC00000 得到 quiet NaN；
        // 而无论 probe.x 是什么，指数位被置满、尾数最高位被置上 ⇒ 恒为 NaN。
        float nan = asfloat(asuint(_VistaFroxelReprojProbe.x) | 0x7FC00000u);
        VistaFroxelBlendHistory((float4)1.0, float4(nan, 0.0, 0.0, 0.0), VISTA_REPROJ_OK, m, w);
        if (m == VISTA_REPROJ_NAN)
            InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_HIT_NAN], 1u);

        // 亮度：current 与 hist 都用合成值，一个全 1 一个全 0 ⇒ rel **恒等于 1**。
        // 于是 t = saturate((1 − start)/(full − start)) ≥ 1 对任何合法的
        // start < full ≤ 1 都成立 —— 这一条因此与场景、与美术填的两个滑条都无关。
        // 拿真实的 current 去比就不是这样：无雾场景下 current.rgb = 0、hist = 0 ⇒
        // rel = 0，这一格会在「场景里没雾」时静默变成空判据。
        VistaFroxelBlendHistory((float4)1.0, (float4)0.0, VISTA_REPROJ_OK, m, w);
        if (m == VISTA_REPROJ_LUMINANCE)
            InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_REPROJ_HIT_LUM], 1u);
    }
}

// ============================================================================
//  #22b 判据的探针：抖动源的统计 + 横向形态两档的聚合对照
//
//  一线程一个瓦片像素（固定 64×64 = 4096 个线程）。它**一张表都不读**：
//  抖动偏移是下标的纯函数，所以这个核不依赖体积的 xy 尺寸，也不需要相机 ——
//  唯一的体积依赖是⑳要用的片数，见下面那条 == 64 的门。
//
//  ---- 为什么窗口正好是 64×64 ----
//  蓝噪声瓦片是**环形**的、周期 64。取一个整周期意味着：
//    · ⑰的「秩均匀 ⇒ 每桶正好 512」是一条精确期望，不是统计近似；
//    · ⑱的邻域对不需要边界处理 —— pixel + (1,0) 在 x = 63 处自然绕回 0，
//      而那正是环形图的真邻居（VistaFroxelBlueNoiseAt 内部取模）；
//    · ⑳的对角恒等式要求 z 跑满 17 在 mod 64 下的整个周期。
//  程序化那一档不是周期函数，pixel + (1,0) 在 x = 63 处给出的是真正的
//  hash(64, ·) —— 也是对的邻居。两档因此共用同一段代码而不需要各自的绕回规则。
//
//  ---- ⑰的期望是怎么算出来的 ----
//  64×64 = 4096 个像素、256 个 8 bit 灰阶、void-and-cluster 的排序是**秩均匀**的
//  ⇒ 每一阶正好 16 个像素。8 个桶按 bin = floor(v·8) 划：
//  bin b 收下的是 b ≤ 8k/255 < b+1，也就是 k ∈ [31.875b, 31.875(b+1))，
//  逐桶点算 k 的个数是 32/32/32/32/32/32/32/32 —— **每桶正好 32 阶 × 16 = 512**。
//  桶界落在 k = 31.875、63.75 … 这些**非整数**上，所以 v·8 永远不会贴着某个整数，
//  fp32 的取整方向在这里不参与结论（余量 ~4e-3，比 eps 大五个量级）。
//  Σv = 2048 精确（均值 0.5 精确）⇒ 抖动偏移 (v − 0.5) 的期望精确为 0
//  ⇒ **开抖动不引入密度偏差**。E[v²] = 511/(6·255) = 0.3339869 ⇒ Var = 0.0839869
//  （连续均匀分布是 1/12 = 0.0833333，差的那一点是 8 bit 量化）。
//  这两个解析值只当 ⓘ 交叉核对：⑱⑲⑳的归一化用的是**实测**的逐通道矩，
//  于是判据的载荷路径上不留任何解析前提。
//
//  ---- ⑳量的是什么 ----
//  Ā(p) = (1/N)·Σ_z u_lat.x(p, z)，也就是一个像素沿整列看到的**聚合横向偏移**。
//  逐列一致档下 Ā ≡ u.x(p, 0)（就是源图自己）；逐片独立档下 Ā 的幅度按 /√N 收缩，
//  但它退化成 h((x−y) mod 64) —— 一个只依赖反对角的一维函数，也就是**对角条纹**
//  （推导见 FroxelVolume.hlsl 的抖动一节）。
//
//  所以⑳量的**不是**相关系数：归一化的一阶相关 ρ₁ 判不出「变白了」——
//  N 个场平均之后分子分母同比缩小，ρ₁ 不变。条纹的预言是一条**逐点恒等式**
//  Ā(x+1,y+1) = Ā(x,y)，它的地板只有 fp32 求和序误差（两列抽样的是**同一个**
//  64 点多重集合、只是起点旋转了 17⁻¹ ≡ 49 片，所以连量化误差都相同）。
//  DAXIS（lag (1,0)）是必需的对照：少了它，一个「Ā 恒为常数」的 bug
//  会把 DDIAG 那条恒等式假通过 —— 而恒为常数正是「抖动整个失效」的样子。
//
//  ---- 一条要在报表上自己说出来的窄化 ----
//  ⑱量的是 lag 1 的邻域相关，**不是**谱。一个 compute 探针里做 FFT 超出范围。
//  可判的内容因此是**符号**（蓝噪声必须显著为负、程序化 ≈ 0），
//  它看不见 lag ≥ 2 上的结构。画面级的残差谱与判据⑯一起放在 #27。
// ============================================================================
#define VISTA_JITTER_PROBE_DIM      64u

// ⑳的门：对角恒等式的推导要求 z 跑满 (17z mod 64) 的整个周期。
// 片数 ≠ 64 时那 64 个抽样点不再是完整的反对角线，恒等式**本来就不该成立** ——
// 于是这一格宁可判成未覆盖，也不去判一条前提不成立的恒等式。
#define VISTA_JITTER_AGG_SLICES     64u

#define VISTA_JITTER_PROBE_SCALE    1.0e5   // 矩：逐线程 ≤ 1 ⇒ ×4096 = 4.1e8 < 4e9
#define VISTA_JITTER_PROBE_D_SCALE  1.0e9   // 逐点差的 max：≤ 1 ⇒ 1e9 < 4e9

// 定点累加/取最大的薄包装。核内**不算任何误差**，误差在 C# 侧算 ——
// 与 FroxelIntegralVerify 同一条约定。
void VistaJitterProbeAdd(uint slot, float v)
{
    InterlockedAdd(_VistaFroxelShadowProbeRW[slot],
                   VistaProbeFixed(v, VISTA_JITTER_PROBE_SCALE));
}

void VistaJitterProbeMax(uint slot, float v)
{
    InterlockedMax(_VistaFroxelShadowProbeRW[slot],
                   VistaProbeFixed(v, VISTA_JITTER_PROBE_D_SCALE));
}

// 动画后的偏移场 n' = frac(n + φ) ∈ [0,1)³，从**被测函数自己的返回值**反推出来：
// j = u·amp、u = n' − 0.5 ⇒ n' = j/amp + 0.5。
// 于是⑱⑲量的是线上那一份实现，而不是「在探针里再写一遍 frac(n + φ)」；
// 而且读数与幅度无关，美术把幅度拖到 0.3 时判据的门不用跟着改。
float3 VistaJitterProbeField(uint3 fid, uint latZStride, bool blueNoise,
                             float3 phase, float2 rcpAmp)
{
    float3 j = VistaFroxelJitterOffsetIn(fid, phase, latZStride, blueNoise);
    return float3(j.xy * rcpAmp.x, j.z * rcpAmp.y) + 0.5;
}

// 一列横向偏移的均值 Ā(p) ∈ [−0.5, 0.5)。只取 x 轴 —— ⑳判的是横向形态。
// 源固定为蓝噪声：这一格要回答的就是「一张蓝噪声资产的收益被逐片独立抹掉了吗」，
// 拿程序化源去问这个问题没有意义（它本来就是白的）。
float VistaJitterProbeColumnMean(uint2 pixel, uint slices, uint latZStride,
                                 float3 phase, float rcpAmpX)
{
    float acc = 0.0;
    for (uint z = 0u; z < slices; z++)
        acc += VistaFroxelJitterOffsetIn(uint3(pixel, z), phase, latZStride, true).x;
    return acc * rcpAmpX / (float)slices;
}

// 一个源档的 11 个矩，写进 [base, base + 10]。
// 组内顺序必须与 VISTA_PROBE_JIT_OFS_* 一致；写错的症状不静默，见槽位表那段注释。
void VistaJitterProbeMoments(uint base, uint2 pixel, bool blueNoise,
                             float3 phase, float2 rcpAmp)
{
    // 三个场都在 slice 0、latZStride = 0 上取：
    // 那是**最难**的一档 —— 深度那一路的抽头此时退化成 x 抽头的一个固定像素偏移
    // （id.z·17 = 0），三路解相关全靠抽头偏移本身。⑲要挡的正是抽头选重。
    float3 n  = VistaJitterProbeField(uint3(pixel,                 0u), 0u, blueNoise, phase, rcpAmp);
    float3 nX = VistaJitterProbeField(uint3(pixel + uint2(1u, 0u), 0u), 0u, blueNoise, phase, rcpAmp);
    float3 nY = VistaJitterProbeField(uint3(pixel + uint2(0u, 1u), 0u), 0u, blueNoise, phase, rcpAmp);

    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_SUM,      n.x);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_SUM + 1u, n.y);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_SUM + 2u, n.z);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_SQ,       n.x * n.x);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_SQ  + 1u, n.y * n.y);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_SQ  + 2u, n.z * n.z);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_NB_X,     n.x * nX.x);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_NB_Y,     n.x * nY.x);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_XY,       n.x * n.y);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_XZ,       n.x * n.z);
    VistaJitterProbeAdd(base + VISTA_PROBE_JIT_OFS_YZ,       n.y * n.z);
}

[numthreads(8, 8, 1)]
void FroxelJitterProbe(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= VISTA_JITTER_PROBE_DIM))
        return;

    // 幅度为 0 时 n' 反推要除 0。CPU 侧的派发门本来就要求两个幅度都 > 0，
    // 这里再挡一次是为了让那条保证**可判**而不是被假设：命中时三个计数槽全 0，
    // 报表会点名「未覆盖」，而不是留下一堆 NaN 定点截断出来的 0。
    if (any(_VistaFroxelJitter.xy <= 0.0))
        return;

    float3 phase  = _VistaFroxelJitterPhase.xyz;
    float2 rcpAmp = 1.0 / _VistaFroxelJitter.xy;

    // ---------------------------------------------------------------- ⑰ 源图
    // 无条件读：即使线上档位是程序化，蓝噪声图也已经被 Editor 侧无条件绑上来了
    // （见 RenderFroxelJitterProbe）—— 否则「线上选了程序化」会让⑰⑲的蓝噪声那半
    // 变成空判据，而空判据在报表上和通过长得一样。
    float v = VistaFroxelBlueNoiseAt(id.xy);
    uint  bin = min((uint)(v * 8.0), 7u);
    InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_BN_HIST0 + bin], 1u);
    VistaJitterProbeAdd(VISTA_PROBE_BN_SUM, v);
    VistaJitterProbeAdd(VISTA_PROBE_BN_SQ,  v * v);
    InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_BN_COUNT], 1u);

    // ⑰d：尺寸从**被测资源自己**问出来（判据⑥a 的同一条理由）。
    // 未绑定时 D3D11 给出 0×0，于是「绑定没到达核」与「绑到了但内容是 0」
    // 不再同形。每个线程写同一个值，InterlockedMax 只是省掉一次分支。
    {
        uint bnW, bnH;
        _VistaFroxelBlueNoise.GetDimensions(bnW, bnH);
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_BN_WIDTH],  bnW);
        InterlockedMax(_VistaFroxelShadowProbeRW[VISTA_PROBE_BN_HEIGHT], bnH);
    }

    // ---------------------------------------------------------------- ⑱⑲ 两档并排
    VistaJitterProbeMoments(VISTA_PROBE_JIT_PROC_BASE, id.xy, false, phase, rcpAmp);
    VistaJitterProbeMoments(VISTA_PROBE_JIT_BLUE_BASE, id.xy, true,  phase, rcpAmp);
    InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_JIT_COUNT], 1u);

    // ---------------------------------------------------------------- 档位接线（双向）
    //  在 **slice 1** 上做，不是 slice 0：latZStride·0 = 0 让两个 z 步进档
    //  逐位相同 ⇒ D_COL ≡ D_SLC ≡ 0 ⇒「恰好有一个为 0」会以**两个都为 0**
    //  的方式假通过 —— 一个自己造不出失败的判据。
    //
    //  两对各只放开一个自由度：z 步进那一对的源取自 cbuffer、源那一对的 z 步进
    //  取自 cbuffer。于是「恰好有一个为 0」在两个维度上分别可判，
    //  而不是被另一个维度的差别掩盖。
    {
        uint3  kid      = uint3(id.xy, 1u);
        float3 online   = VistaFroxelJitterOffset(kid);
        uint   strideCB = VistaFroxelJitterZStride();
        bool   blueCB   = VistaFroxelJitterUseBlueNoise();

        float3 dCol  = abs(online - VistaFroxelJitterOffsetIn(kid, phase, 0u, blueCB));
        float3 dSlc  = abs(online - VistaFroxelJitterOffsetIn(kid, phase, 1u, blueCB));
        float3 dProc = abs(online - VistaFroxelJitterOffsetIn(kid, phase, strideCB, false));
        float3 dBlue = abs(online - VistaFroxelJitterOffsetIn(kid, phase, strideCB, true));

        VistaJitterProbeMax(VISTA_PROBE_JIT_D_COL,  max(max(dCol.x,  dCol.y),  dCol.z));
        VistaJitterProbeMax(VISTA_PROBE_JIT_D_SLC,  max(max(dSlc.x,  dSlc.y),  dSlc.z));
        VistaJitterProbeMax(VISTA_PROBE_JIT_D_PROC, max(max(dProc.x, dProc.y), dProc.z));
        VistaJitterProbeMax(VISTA_PROBE_JIT_D_BLUE, max(max(dBlue.x, dBlue.y), dBlue.z));
    }

    // ---------------------------------------------------------------- ⑳ 聚合两档
    uint slices = (uint)(VISTA_FROXEL_SLICES + 0.5);
    if (slices != VISTA_JITTER_AGG_SLICES)
        return;   // 计数槽留 0，报表点名未覆盖 + 原因

    float aCol  = VistaJitterProbeColumnMean(id.xy,                 slices, 0u, phase, rcpAmp.x);
    float aColX = VistaJitterProbeColumnMean(id.xy + uint2(1u, 0u), slices, 0u, phase, rcpAmp.x);
    float aColD = VistaJitterProbeColumnMean(id.xy + uint2(1u, 1u), slices, 0u, phase, rcpAmp.x);
    float aSlc  = VistaJitterProbeColumnMean(id.xy,                 slices, 1u, phase, rcpAmp.x);
    float aSlcX = VistaJitterProbeColumnMean(id.xy + uint2(1u, 0u), slices, 1u, phase, rcpAmp.x);
    float aSlcD = VistaJitterProbeColumnMean(id.xy + uint2(1u, 1u), slices, 1u, phase, rcpAmp.x);

    // 存 Ā + 0.5 而不是 Ā：定点槽是 uint，负数会被 clamp 成 0
    // ——「一个把负数压成 0 的格式化函数会让三种状态在报表上长得一样」。
    // 编码与 n' 相同（都是 [0,1)），于是⑳的 COL 档矩可以直接与⑲的蓝噪声 x 通道
    // 矩对账：逐列一致档下 Ā ≡ u.x(p,0)，两组独立累加的读数必须相等。
    VistaJitterProbeAdd(VISTA_PROBE_AGG_COL_SUM, aCol + 0.5);
    VistaJitterProbeAdd(VISTA_PROBE_AGG_COL_SQ,  (aCol + 0.5) * (aCol + 0.5));
    VistaJitterProbeMax(VISTA_PROBE_AGG_COL_DAXIS, abs(aColX - aCol));
    VistaJitterProbeMax(VISTA_PROBE_AGG_COL_DDIAG, abs(aColD - aCol));

    VistaJitterProbeAdd(VISTA_PROBE_AGG_SLC_SUM, aSlc + 0.5);
    VistaJitterProbeAdd(VISTA_PROBE_AGG_SLC_SQ,  (aSlc + 0.5) * (aSlc + 0.5));
    VistaJitterProbeMax(VISTA_PROBE_AGG_SLC_DAXIS, abs(aSlcX - aSlc));
    VistaJitterProbeMax(VISTA_PROBE_AGG_SLC_DDIAG, abs(aSlcD - aSlc));

    InterlockedAdd(_VistaFroxelShadowProbeRW[VISTA_PROBE_AGG_COUNT], 1u);
}
